{
  "backend": "cuda",
  "exe": "build/tintero",
  "args": [
    "--model",
    "models/Inkling-2-Mini-UD-Q4_K_XL.gguf",
    "--max-context",
    "131072",
    "--chunk",
    "1024"
  ],
  "env": {
    "IK2_KV": "fp8",
    "IK2_FAST_LOAD": "1",
    "IK2_BATCH": "32",
    "IK2_BATCH_GROUP_MOE": "1",
    "IK2_BLACKWELL_NVFP4": "1"
  },
  "tokenizer": "ik2/tokenizer",
  "model_name": "inkling-2-mini"
}
