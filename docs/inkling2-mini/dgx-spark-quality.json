{
  "backend": "cuda",
  "exe": "build/tintero",
  "args": [
    "--model",
    "models/Inkling-2-Mini-IQ4_NL.gguf",
    "--max-context",
    "262144",
    "--chunk",
    "1024",
    "--draft",
    "models/mtp.safetensors"
  ],
  "env": {
    "IK2_KV": "fp8",
    "IK2_FAST_LOAD": "1",
    "IK2_DRAFT_CTX": "65536",
    "IK2_BATCH_PREFILL": "1"
  },
  "tokenizer": "ik2/tokenizer",
  "model_name": "inkling-2-mini"
}
